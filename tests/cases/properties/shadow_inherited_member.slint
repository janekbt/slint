// A derived component may declare a member whose name already exists in its base, as long as the
// base member is private (invisible here) or marked `@shadowable`. The base keeps using its own
// member. https://github.com/slint-ui/slint/issues/12881 and https://github.com/slint-ui/slint/issues/1937

component Base {
    // Only visible within Base, so shadowing it needs no opt-in
    private property <string> secret: "base-secret";
    @shadowable in-out property <string> name: "Hello";
    @shadowable pure callback describe() -> string;
    describe => { self.name + "/" + self.secret }

    out property <string> base-view: self.name + "/" + self.secret + "/" + self.describe();
}

component Derived inherits Base {
    property <string> secret: "derived-secret";
    in-out property <string> name: "Argh";
    pure callback describe() -> string;
    describe => { "derived" }

    out property <string> derived-view: self.name + "/" + self.secret + "/" + self.describe();
}

// Shadowing a builtin member that a base component uses: `UsesFlickable` still reads the real
// `content-width` of the Flickable it inherits from.
component UsesFlickable inherits Flickable {
    content-width: 34px;
    out property <length> flickable-content-width: self.content-width;
}

component Wrapper inherits UsesFlickable {
    in-out property <length> content-width: 7px;
}

export component TestCase inherits Window {
    d := Derived {}

    out property <string> base-view: d.base-view;
    out property <string> derived-view: d.derived-view;
    in-out property <string> name <=> d.name;

    w := Wrapper {
        content-width: 12px;
    }
    out property <length> wrapper-flickable-content-width: w.flickable-content-width;
    out property <length> wrapper-content-width: w.content-width;
}

