// A declaration may shadow a member inherited from a base component when that member is private
// (and therefore invisible here) or marked `@shadowable`. The shadowing declaration is registered
// under an internal name, so the base component keeps using its own member.

component Base {
    private property <string> secret;
    pure function helper() -> int { 1 }
    @shadowable in-out property <string> name: "Hello";
    @shadowable callback activated();
    @shadowable public function describe() -> string { "base" }
    in-out property <string> plain;
    callback plain-callback();
    public function plain-function() {}
}

// https://github.com/slint-ui/slint/issues/1937: a private base member isn't visible here,
// so shadowing it is silent
component ShadowsPrivate inherits Base {
    property <string> secret;
    function helper() -> int { 2 }
}

// https://github.com/slint-ui/slint/issues/12881: a `@shadowable` member may be shadowed with a warning
component ShadowsOptedIn inherits Base {
    in-out property <string> name: "Argh";
//                           >  <warning{'name' shadows the inherited property of the same name}
    callback activated();
//           >       <warning{'activated' shadows the inherited callback of the same name}
    public function describe() -> string { "derived" }
//                  >      <warning{'describe' shadows the inherited function of the same name}
}

// The kind may change: shadowing is by name only
component ShadowsWithOtherKind inherits Base {
    callback name();
//           >  <warning{'name' shadows the inherited property of the same name}
}

// Without the opt-in, overriding is still an error
component NotOptedIn inherits Base {
    in-out property <string> plain;
//                           >   <error{Cannot override property 'plain' declared in 'Base'}
    callback plain-callback();
//           >            <error{Cannot override callback 'plain-callback' declared in 'Base'}
    public function plain-function() {}
//                  >            <error{Cannot override 'plain-function' declared in 'Base'}
}

// A shadow can itself be shadowed further down the chain, and be opted into again
component Middle inherits Base {
    @shadowable in-out property <string> name: "Middle";
//                                       >  <warning{'name' shadows the inherited property of the same name}
}

component Leaf inherits Middle {
    in-out property <string> name: "Leaf";
//                           >  <warning{'name' shadows the inherited property of the same name}
    out property <string> check: root.name;
}

// Declaring the same name twice on one element is still a conflict
component Twice inherits Base {
    in-out property <string> name;
//                           >  <warning{'name' shadows the inherited property of the same name}
    in-out property <string> name;
//                           >  <error{Cannot override property 'name'}
    callback activated();
//           >       <warning{'activated' shadows the inherited callback of the same name}
    callback activated();
//           >       <error{Duplicated callback declaration}
}

// Reserved properties that exist on every element are not shadowable
component NotReserved inherits Base {
    property <int> x;
//                 ^error{Cannot override property 'x'}
}

export component Test inherits Window {
    b := Base {}
    out property <string> from-base: b.name;
    ShadowsPrivate {}
    ShadowsOptedIn {}
    ShadowsWithOtherKind {}
    NotOptedIn {}
    Leaf {}
    Twice {}
    NotReserved {}
}
